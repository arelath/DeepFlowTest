<Window x:Class="DeepFlowTest.Recorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepFlowTest Recorder"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="480"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid Background="#F7F8FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#D7DCE2"
            BorderThickness="0,0,0,1">
      <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Foreground="#3D4652"
                   Text="Filter" />
        <TextBox x:Name="FilterTextBox"
                 Grid.Column="1"
                 Height="32"
                 VerticalContentAlignment="Center"
                 TextChanged="FilterTextBox_TextChanged" />

        <TextBox x:Name="OutputPathTextBox"
                 Grid.Column="3"
                 Height="32"
                 VerticalContentAlignment="Center" />
        <Button Grid.Column="5"
                MinWidth="82"
                Height="32"
                Click="BrowseOutput_Click"
                Content="Browse..." />
        <Button x:Name="RefreshButton"
                Grid.Column="7"
                MinWidth="82"
                Height="32"
                Click="Refresh_Click"
                Content="Refresh" />
      </Grid>
    </Border>

    <DataGrid x:Name="ProcessGrid"
              Grid.Row="1"
              Margin="16"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Process"
                            Binding="{Binding DisplayName}"
                            Width="2*" />
        <DataGridTextColumn Header="PID"
                            Binding="{Binding ProcessId}"
                            Width="90" />
        <DataGridTextColumn Header="Window"
                            Binding="{Binding WindowTitle}"
                            Width="3*" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#D7DCE2"
            BorderThickness="0,1,0,0">
      <Grid Margin="16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="#3D4652"
                   TextWrapping="Wrap"
                   Text="Ready" />
        <Button x:Name="StartButton"
                Grid.Row="0"
                Grid.Column="1"
                MinWidth="96"
                Height="34"
                Click="StartRecording_Click"
                Content="Start" />
        <Button x:Name="StopButton"
                Grid.Row="0"
                Grid.Column="3"
                MinWidth="96"
                Height="34"
                IsEnabled="False"
                Click="StopRecording_Click"
                Content="Stop" />

        <Expander x:Name="FailureDetailsExpander"
                  Grid.Row="1"
                  Grid.ColumnSpan="4"
                  Margin="0,10,0,0"
                  Header="Failure details"
                  Visibility="Collapsed">
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Top"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Height="30"
                    Click="CopyFailureDetails_Click"
                    Content="Copy details" />
            <TextBox x:Name="FailureDetailsTextBox"
                     Margin="0,8,0,0"
                     MinHeight="120"
                     MaxHeight="240"
                     AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Expander>
      </Grid>
    </Border>
  </Grid>
</Window>
