<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeepFlowTest.Recorder</RootNamespace>
    <AssemblyName>DeepFlowTest.Recorder</AssemblyName>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(ArtifactsRoot)publish\$(MSBuildProjectName)\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepFlowTest\DeepFlowTest.csproj" />
  </ItemGroup>

  <Import Project="..\Shared\DeepFlowTestPayloadLayout.targets" />
</Project>
