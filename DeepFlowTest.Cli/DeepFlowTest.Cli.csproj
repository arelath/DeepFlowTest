<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeepFlowTest.Cli</RootNamespace>
    <AssemblyName>DeepFlowTest.Cli</AssemblyName>
    <IsPackable>false</IsPackable>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(RepositoryRoot)artifacts\DeepFlowTest.Cli\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NativeMethods.cs" Link="Shared\NativeMethods.cs" />
    <Compile Include="..\Shared\NativeMethods.Kernel32.cs" Link="Shared\NativeMethods.Kernel32.cs" />
    <Compile Include="..\Shared\NativeMethods.User32.cs" Link="Shared\NativeMethods.User32.cs" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\DeepFlowTest\DeepFlowTest.csproj" />
  </ItemGroup>

  <Import Project="..\Shared\DeepFlowTestPayloadLayout.targets" />
</Project>
