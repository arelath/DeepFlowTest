<Window x:Class="DeepFlowTest.Mcp.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepFlowTest MCP"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="#FFF4F6F8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,3,0,8" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Background="#FFFFFFFF"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Ellipse Width="10"
                   Height="10"
                   Fill="#FF2FA866"
                   Margin="0,0,8,0" />
          <TextBlock Text="{Binding ServerStateText}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Grid.Column="1"
                 Text="{Binding StreamableHttpUrl, Mode=OneWay}"
                 IsReadOnly="True"
                 Margin="16,0"
                 VerticalContentAlignment="Center" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal">
          <Button Content="Copy"
                  Command="{Binding CopyUrlCommand}" />
          <Button Content="Start"
                  Command="{Binding StartServerCommand}" />
          <Button Content="Stop"
                  Command="{Binding StopServerCommand}" />
          <Button Content="Panic / Detach"
                  Command="{Binding PanicDetachCommand}"
                  FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusLine}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding LastError}" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Column="0"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource PanelBorder}"
                  Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Target"
                         Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding TargetSummary}"
                         Margin="0,0,0,10" />

              <TextBlock Text="PID"
                         Style="{StaticResource LabelText}" />
              <TextBox Text="{Binding AttachPidText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Process"
                         Style="{StaticResource LabelText}" />
              <TextBox Text="{Binding AttachProcessName, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Window title"
                         Style="{StaticResource LabelText}" />
              <TextBox Text="{Binding AttachWindowTitle, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="Attach"
                      Command="{Binding AttachCommand}"
                      HorizontalAlignment="Left" />

              <Separator Margin="0,12,0,10" />
              <TextBlock Text="Launch path"
                         Style="{StaticResource LabelText}" />
              <TextBox Text="{Binding LaunchPath, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Arguments"
                         Style="{StaticResource LabelText}" />
              <TextBox Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" />
              <CheckBox Content="Terminate on detach"
                        IsChecked="{Binding TerminateOnDetach}"
                        Margin="0,0,0,8" />
              <Button Content="Launch"
                      Command="{Binding LaunchCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelBorder}"
                  Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Policy"
                         Style="{StaticResource SectionTitle}" />
              <CheckBox Content="Allow launch"
                        IsChecked="{Binding AllowLaunch}" />
              <CheckBox Content="Allow actions"
                        IsChecked="{Binding AllowActions}" />
              <CheckBox Content="Allow arbitrary invoke"
                        IsChecked="{Binding AllowArbitraryInvoke}" />
              <CheckBox Content="Allow file writes"
                        IsChecked="{Binding AllowFileWrites}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelBorder}">
            <StackPanel>
              <TextBlock Text="Virtual Pointer"
                         Style="{StaticResource SectionTitle}" />
              <CheckBox Content="Enabled"
                        IsChecked="{Binding VirtualPointerEnabled}" />
              <CheckBox Content="Click ripples"
                        IsChecked="{Binding VirtualPointerClickRipples}" />
              <CheckBox Content="Drag trail"
                        IsChecked="{Binding VirtualPointerDragTrail}" />
              <CheckBox Content="Include in screenshots"
                        IsChecked="{Binding VirtualPointerInScreenshots}" />
              <TextBlock Text="Hide delay ms"
                         Style="{StaticResource LabelText}"
                         Margin="0,8,0,0" />
              <TextBox Text="{Binding VirtualPointerHideDelayMs, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="Apply"
                      Command="{Binding ApplyVirtualPointerCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1"
              Style="{StaticResource PanelBorder}"
              Margin="10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Activity"
                       Style="{StaticResource SectionTitle}"
                       DockPanel.Dock="Left" />
            <TextBox Text="{Binding ActivityFilter, UpdateSourceTrigger=PropertyChanged}"
                     Width="220"
                     DockPanel.Dock="Right"
                     ToolTip="Filter" />
          </DockPanel>
          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding ActivityEvents}"
                    SelectedItem="{Binding SelectedActivity}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    RowHeaderWidth="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time"
                                  Binding="{Binding TimeText}"
                                  Width="74" />
              <DataGridTextColumn Header="Source"
                                  Binding="{Binding Source}"
                                  Width="70" />
              <DataGridTextColumn Header="Kind"
                                  Binding="{Binding Kind}"
                                  Width="110" />
              <DataGridTextColumn Header="Name"
                                  Binding="{Binding Name}"
                                  Width="170" />
              <DataGridTextColumn Header="Status"
                                  Binding="{Binding Status}"
                                  Width="78" />
              <DataGridTextColumn Header="Summary"
                                  Binding="{Binding Summary}"
                                  Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="220" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PanelBorder}"
                Margin="0,0,0,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Details"
                       Style="{StaticResource SectionTitle}" />
            <TextBox Grid.Row="1"
                     Text="{Binding SelectedActivityDetails, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </Border>
        <Border Grid.Row="1"
                Style="{StaticResource PanelBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Streams"
                       Style="{StaticResource SectionTitle}" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ActiveStreams}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
