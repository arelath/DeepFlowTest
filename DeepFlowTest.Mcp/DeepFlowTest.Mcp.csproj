<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeepFlowTest.Mcp</RootNamespace>
    <AssemblyName>DeepFlowTest.Mcp</AssemblyName>
    <IsPackable>false</IsPackable>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(ArtifactsRoot)publish\$(MSBuildProjectName)\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <ProjectReference Include="..\DeepFlowTest\DeepFlowTest.csproj" />
    <ProjectReference Include="..\DeepFlowTest.Cli\DeepFlowTest.Cli.csproj" />
  </ItemGroup>

  <Import Project="..\Shared\DeepFlowTestPayloadLayout.targets" />
</Project>
