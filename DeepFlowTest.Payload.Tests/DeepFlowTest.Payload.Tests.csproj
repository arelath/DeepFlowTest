    <Compile Include="..\DeepFlowTest.Tests\ProtocolCommandTests.cs" Link="ProtocolCommandTests.cs" />
	<Compile Include="..\DeepFlowTest.Tests\ReliabilityPackagingTests.cs" Link="ReliabilityPackagingTests.cs" />
