{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "summary",
    "contextId",
    "operations",
    "assertions",
    "errors"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "contextId": {
      "type": ["string", "null"]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "succeeded", "note"],
        "properties": {
          "tool": { "type": "string" },
          "succeeded": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "actual"],
        "properties": {
          "id": { "type": "string" },
          "passed": { "type": "boolean" },
          "actual": { "type": ["string", "null"] }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
