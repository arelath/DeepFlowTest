<Project>
  <PropertyGroup>
    <!-- The SDK requires TargetFrameworks as a property during static evaluation. The
         evaluated validation in the client and payload projects prevents this mirror from
         drifting from the authoritative PayloadFramework items below. -->
    <DeepFlowTestTargetFrameworks>net461;netcoreapp3.1;net5.0-windows</DeepFlowTestTargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PayloadFramework Include="net461" Family="netframework" />
    <PayloadFramework Include="netcoreapp3.1" Family="netcoreapp" />
    <PayloadFramework Include="net5.0-windows" Family="dotnet" />
  </ItemGroup>
</Project>
