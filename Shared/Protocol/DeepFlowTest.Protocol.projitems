<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Contracts\**\*.cs" Link="Shared\Protocol\Contracts\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Serialization\**\*.cs" Link="Shared\Protocol\Serialization\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Snapshots\**\*.cs" Link="Shared\Protocol\Snapshots\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Startup\**\*.cs" Link="Shared\Protocol\Startup\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
