<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>$(DeepFlowTestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>DeepFlowTest</RootNamespace>
    <AssemblyName>DeepFlowTest</AssemblyName>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>WPF application automation library.</Description>
    <PackageTags>WPF;Automation;Testing;UI</PackageTags>
    <PackageProjectUrl>https://deepflowtest.local</PackageProjectUrl>
    <RepositoryUrl>https://deepflowtest.local/repository</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <PackageId>DeepFlowTest</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Payload and native injector DLLs are executable content, not compile references. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NativeMethods.cs" Link="Shared\NativeMethods.cs" />
    <Compile Include="..\Shared\NativeMethods.Kernel32.cs" Link="Shared\NativeMethods.Kernel32.cs" />
    <Compile Include="..\Shared\NativeMethods.User32.cs" Link="Shared\NativeMethods.User32.cs" />
    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serialize.Linq" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.ValueTuple" />
    <None Include="$(ArtifactsStagingRoot)payloads\**\*.*" Pack="true" PackagePath="contentFiles\any\any\payloads\%(RecursiveDir)%(Filename)%(Extension)" PackageCopyToOutput="true" Visible="false" />
    <None Include="$(ArtifactsStagingRoot)DeepFlowTestResources\**\*.*" Pack="true" PackagePath="contentFiles\any\any\DeepFlowTestResources\%(RecursiveDir)%(Filename)%(Extension)" PackageCopyToOutput="true" Visible="false" />
    <None Include="DeepFlowTest.targets" Pack="true" PackagePath="build\DeepFlowTest.targets" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Import Project="..\Shared\Protocol\DeepFlowTest.Protocol.projitems" />
  <Import Project="..\Shared\QueryModel\DeepFlowTest.QueryModel.projitems" />

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ValidateDeepFlowTestPackageInputs" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_EvaluatedPayloadFrameworks>@(PayloadFramework, ';')</_EvaluatedPayloadFrameworks>
    </PropertyGroup>
    <Error Condition="'$(_EvaluatedPayloadFrameworks)' != '$(DeepFlowTestTargetFrameworks)'" Text="DeepFlowTestTargetFrameworks must match the PayloadFramework item identities and order." />
    <Error Condition="'%(PayloadFramework.Family)' == ''" Text="PayloadFramework '%(PayloadFramework.Identity)' must declare Family metadata." />
    <Error Condition="!Exists('$(ArtifactsStagingRoot)payloads')" Text="Payload staging is missing. Build the payloads before packing." />
    <Error Condition="!Exists('$(ArtifactsStagingRoot)DeepFlowTestResources')" Text="Injector staging is missing. Build the native injectors before packing." />
  </Target>
</Project>
