<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>$(DeepFlowTestTargetFrameworks)</TargetFrameworks>
    <AssemblyName>DeepFlowTest</AssemblyName>
    <RootNamespace>DeepFlowTest</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="AppDriverPayload\**\*.cs" />
    <Compile Include="Utility\**\*.cs" />
    <Compile Include="Interop\**\*.cs" />
    <Compile Include="..\Shared\NativeMethods.cs" Link="Shared\NativeMethods.cs" />
    <Compile Include="..\Shared\NativeMethods.Kernel32.cs" Link="Shared\NativeMethods.Kernel32.cs" />
    <Compile Include="..\Shared\NativeMethods.User32.cs" Link="Shared\NativeMethods.User32.cs" />
  </ItemGroup>

  <ItemGroup>
    <PayloadDependency Include="Lib.Harmony" AssemblyFile="0Harmony.dll" />
    <PayloadDependency Include="Newtonsoft.Json" AssemblyFile="Newtonsoft.Json.dll" />
    <PayloadDependency Include="Serialize.Linq" AssemblyFile="Serialize.Linq.dll" />
    <PayloadDependency Include="System.Buffers" AssemblyFile="System.Buffers.dll" />
    <PayloadDependency Include="System.Memory" AssemblyFile="System.Memory.dll" />
    <PayloadDependency Include="System.Numerics.Vectors" AssemblyFile="System.Numerics.Vectors.dll" />
    <PayloadDependency Include="System.Runtime.CompilerServices.Unsafe" AssemblyFile="System.Runtime.CompilerServices.Unsafe.dll" />
    <PayloadDependency Include="System.ValueTuple" AssemblyFile="System.ValueTuple.dll" />
    <PackageReference Include="@(PayloadDependency)" />
    <PackageReference Remove="System.Numerics.Vectors;System.Runtime.CompilerServices.Unsafe" />
    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\Shared\Protocol\DeepFlowTest.Protocol.projitems" />
  <Import Project="..\Shared\QueryModel\DeepFlowTest.QueryModel.projitems" />
  <Import Project="..\Shared\DeepFlowTest.PayloadRepack.targets" />
</Project>
