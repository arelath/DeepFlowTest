<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DependencyConflictHarness</RootNamespace>
    <AssemblyName>DependencyConflictHarness</AssemblyName>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Intentionally older than the payload's centrally managed Newtonsoft.Json 13.0.3. -->
    <PackageReference Include="Newtonsoft.Json" VersionOverride="12.0.3" />
  </ItemGroup>
</Project>
