<Project>
  <Import Project="$(MSBuildThisFileDirectory)Shared\DeepFlowTest.Frameworks.props" />

  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <ArtifactsRoot>$(RepositoryRoot)artifacts\</ArtifactsRoot>
    <ArtifactsBinRoot>$(ArtifactsRoot)bin\</ArtifactsBinRoot>
    <ArtifactsObjRoot>$(ArtifactsRoot)obj\</ArtifactsObjRoot>
    <ArtifactsStagingRoot>$(ArtifactsRoot)staging\</ArtifactsStagingRoot>
    <ArtifactsPackagesRoot>$(ArtifactsRoot)packages\</ArtifactsPackagesRoot>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <DisableUnsupportedNETCoreTargetFrameworkWarnings>true</DisableUnsupportedNETCoreTargetFrameworkWarnings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(ArtifactsBinRoot)$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(ArtifactsObjRoot)$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(ArtifactsPackagesRoot)$(Configuration)\</PackageOutputPath>
    <Version Condition="Exists('$(RepositoryRoot)version.txt')">$([System.IO.File]::ReadAllText('$(RepositoryRoot)version.txt').Trim())</Version>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1503;NETSDK1137;NETSDK1138;NETSDK1222;MSB3277;CS1591;CA1021;CA1063;CA1816;NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AutoGenerateBindingRedirects Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>DeepFlowTest</Company>
    <Product>DeepFlowTest</Product>
    <Copyright>Copyright (c) $([System.DateTime]::Today.ToString(yyyy))</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageId Condition="'$(PackageId)' == ''">$(AssemblyName)</PackageId>
    <Authors>DeepFlowTest</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EmbedAllSources>true</EmbedAllSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <DebugType>full</DebugType>
  </PropertyGroup>
</Project>
